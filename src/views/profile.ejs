<!-- ============================================================
     ⚠️  VULNERABLE — intentional XSS for CodeQL demo
          (Block 5, step 2 — Code Scanning alert)
     The bio field is rendered using <%- %> (unescaped) instead
     of <%= %> (escaped). This allows script injection.
     ============================================================ -->
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= user.name %>'s Profile — QA Demo App</title>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; max-width: 600px; margin: 40px auto; padding: 0 20px; }
    h1 { color: #24292f; }
    .card { border: 1px solid #d0d7de; border-radius: 6px; padding: 20px; }
    .label { font-weight: 600; color: #57606a; }
    a { color: #0969da; }
  </style>
</head>
<body>
  <h1>👤 <%= user.name %></h1>
  <div class="card">
    <p><span class="label">Email:</span> <%= user.email %></p>
    <p><span class="label">Member since:</span> <%= user.created_at %></p>
    <p><span class="label">Bio:</span></p>
    <!-- ❌ VULNERABLE — unescaped output allows XSS -->
    <div class="bio"><%- user.bio %></div>
  </div>
  <p><a href="/">← Back to home</a></p>
</body>
</html>
