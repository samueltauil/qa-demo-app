<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Search Products — QA Demo App</title>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; max-width: 600px; margin: 40px auto; padding: 0 20px; }
    h1 { color: #24292f; }
    form { display: flex; gap: 8px; margin-bottom: 20px; }
    input[type="text"] { flex: 1; padding: 8px; border: 1px solid #d0d7de; border-radius: 6px; font-size: 14px; }
    button { padding: 8px 16px; background: #0969da; color: white; border: none; border-radius: 6px; cursor: pointer; }
    table { width: 100%; border-collapse: collapse; }
    th, td { text-align: left; padding: 8px; border-bottom: 1px solid #d0d7de; }
    th { background: #f6f8fa; }
    .error { color: #cf222e; }
    a { color: #0969da; }
  </style>
</head>
<body>
  <h1>🔍 Search Products</h1>
  <form method="GET" action="/search">
    <input type="text" name="q" value="<%= query %>" placeholder="Search by name or description...">
    <button type="submit">Search</button>
  </form>

  <% if (typeof error !== 'undefined') { %>
    <p class="error"><%= error %></p>
  <% } %>

  <% if (results.length > 0) { %>
    <table>
      <thead>
        <tr><th>Name</th><th>Description</th><th>Price</th><th>Category</th></tr>
      </thead>
      <tbody>
        <% results.forEach(p => { %>
          <tr>
            <td><%= p.name %></td>
            <td><%= p.description %></td>
            <td>$<%= p.price.toFixed(2) %></td>
            <td><%= p.category %></td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  <% } else if (query) { %>
    <p>No products found for "<%= query %>".</p>
  <% } %>

  <p><a href="/">← Back to home</a></p>
</body>
</html>
