<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Error — QA Demo App</title>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; max-width: 600px; margin: 40px auto; padding: 0 20px; }
    .error-box { background: #ffebe9; border: 1px solid #cf222e; padding: 16px; border-radius: 6px; }
    a { color: #0969da; }
  </style>
</head>
<body>
  <div class="error-box">
    <h2>Error</h2>
    <p><%= message %></p>
  </div>
  <p><a href="/">← Back to home</a></p>
</body>
</html>
