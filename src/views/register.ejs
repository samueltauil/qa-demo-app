<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Register — QA Demo App</title>
  <style>
    body { font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif; max-width: 500px; margin: 40px auto; padding: 0 20px; }
    h1 { color: #24292f; }
    form { display: flex; flex-direction: column; gap: 12px; }
    label { font-weight: 600; }
    input { padding: 8px; border: 1px solid #d0d7de; border-radius: 6px; font-size: 14px; }
    button { padding: 10px; background: #2da44e; color: white; border: none; border-radius: 6px; font-size: 14px; cursor: pointer; }
    button:hover { background: #218838; }
    .error { color: #cf222e; margin-top: 8px; }
    .success { color: #1a7f37; margin-top: 8px; }
    a { color: #0969da; }
  </style>
</head>
<body>
  <h1>Create Account</h1>
  <form id="registerForm" action="/api/users/register" method="POST">
    <label for="name">Full Name</label>
    <input type="text" id="name" name="name" placeholder="Jane Doe" required>

    <label for="email">Email</label>
    <input type="email" id="email" name="email" placeholder="jane@company.com" required>

    <label for="password">Password</label>
    <input type="password" id="password" name="password" placeholder="Min 8 chars, include a number" required minlength="8">

    <button type="submit">Register</button>
  </form>
  <div id="message"></div>
  <p><a href="/">← Back to home</a></p>

  <script>
    document.getElementById('registerForm').addEventListener('submit', async (e) => {
      e.preventDefault();
      const form = e.target;
      const data = {
        name: form.name.value,
        email: form.email.value,
        password: form.password.value
      };
      try {
        const res = await fetch('/api/users/register', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(data)
        });
        const result = await res.json();
        const msg = document.getElementById('message');
        if (res.ok) {
          msg.className = 'success';
          msg.textContent = `Account created! Welcome, ${result.name}.`;
          form.reset();
        } else {
          msg.className = 'error';
          msg.textContent = result.error;
        }
      } catch (err) {
        document.getElementById('message').textContent = 'Network error.';
      }
    });
  </script>
</body>
</html>
